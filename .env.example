APP_DIR=/opt/local-doc-classifier
VAULT_DIR=/opt/local-doc-classifier/vault
VAULT_NFS_REMOTE=
VAULT_NFS_MOUNT_DIR=/mnt/cloud-vault
VAULT_NFS_OPTIONS=defaults,_netdev,nofail,x-systemd.automount,x-systemd.idle-timeout=600,x-systemd.device-timeout=30,timeo=14,retrans=3
CLASSIFY_MODEL=qwen2.5:3b
VISION_MODEL=qwen2.5vl:3b
PULL_VISION_MODEL=1
TZ=America/Anchorage
OLLAMA_PORT=11434
CLASSIFIER_API_PORT=4319
CLASSIFIER_API_BIND=0.0.0.0
CLASSIFIER_API_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL
